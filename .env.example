# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=mail.get-hub.io,localhost,127.0.0.1

# Database
DB_PASSWORD=strong-database-password-here

# Redis
REDIS_URL=redis://cold-email-redis:6379/0

# App URL (for tracking links in emails)
APP_BASE_URL=https://mail.get-hub.io

# n8n webhook (outgoing events)
N8N_WEBHOOK_URL=https://n8n.get-hub.io/webhook/cold-email-events
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# API Token for n8n → Django
API_TOKEN=your-secure-api-token-here

# Encryption key for SMTP passwords (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=your-fernet-encryption-key-here

# Email from defaults
DEFAULT_FROM_NAME=North Cleaning Services GmbH
DEFAULT_REPLY_TO=info@north-cleaning-services.de

# Celery
CELERY_BROKER_URL=redis://cold-email-redis:6379/0
CELERY_RESULT_BACKEND=redis://cold-email-redis:6379/1
